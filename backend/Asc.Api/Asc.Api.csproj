<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>64602874-1221-4e66-b3f6-a5fb853997ab</UserSecretsId>
    <!-- NPOI's OOXML module bundles the OSMF-licensed font used for some rendering paths (not used by our
         cell-value-only parsing, but the build needs this acknowledged either way). -->
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets Asc.Api.Tests exercise internal-only seams (e.g. MasterDataResolver's pure
         BuildIndex/ResolveFrom statics) without making them part of the public API surface. -->
    <InternalsVisibleTo Include="Asc.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pins NPOI's transitive System.Security.Cryptography.Xml (used internally for OOXML
         digital-signature support NPOI ships but this app's read-only cell-value parsing never
         touches) up from 8.0.2, which carries 8 High-severity advisories, to a patched release
         on the same 9.x line as the rest of this project's Microsoft.* packages. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.19" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.17" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="9.0.17" />
    <PackageReference Include="MongoDB.Driver" Version="3.10.0" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="PdfPig" Version="0.1.10" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

</Project>
