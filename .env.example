# Copy to .env and fill in before running `docker compose up --build`.
# .env itself is gitignored — never commit real secrets.

# MongoDB Atlas connection string (the app has never used a local Mongo — dev and
# containerized deployment both point at the same cloud cluster).
MONGO_CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net
MONGO_DATABASE_NAME=asc_tea

# Random string, 32+ characters — HMAC-SHA256 JWT signing key.
JWT_KEY=

# Comma-separated list of origins allowed to call the API (the deployed frontend's URL).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# The frontend's own build-time setting: where it should send API requests.
PUBLIC_API_BASE_URL=http://localhost:5058

# Production only (docker-compose.prod.yml / deploy/Caddyfile): the one public domain.
# Set all three to the same origin — e.g. SITE_ADDRESS=hub.example.com,
# PUBLIC_API_BASE_URL=https://hub.example.com, CORS_ALLOWED_ORIGINS=https://hub.example.com —
# see DEPLOYMENT.md "Production on a VPS".
SITE_ADDRESS=

# AI provider keys — optional; a provider with no key simply reports itself as
# unconfigured at GET /api/v1/assistant/providers rather than failing startup.
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# OKLO SmartAuction API (live sale data) — all optional; see docs/31_OKLO_Live_Data.md.
# Values come from OKLO's onboarding email. OKLO_AUTO_SYNC=true starts the background refresh
# (it rewrites files under data/sales, so back the folder up before the first run).
OKLO_TOKEN_URL=
OKLO_BASE_URL=https://smartauctionreports.okloapps.com
OKLO_SCOPE=
OKLO_CLIENT_ID=
OKLO_CLIENT_SECRET=
OKLO_USERNAME=
OKLO_PASSWORD=
OKLO_AUTO_SYNC=false
OKLO_FIRST_YEAR=2023
# Store every OKLO sale once in MongoDB in the background (throttled). On ONE instance only if you scale out.
OKLO_SNAPSHOT_BACKFILL=true
