# Production reverse proxy — single domain, automatic HTTPS (Let's Encrypt).
#
# SITE_ADDRESS comes from the environment (see docker-compose.prod.yml), e.g.
# hub.example.com. Point the domain's DNS A record at the server before first
# start — Caddy obtains and renews the certificate automatically.
#
# Single-domain layout on purpose: the frontend is built with
# PUBLIC_API_BASE_URL set to this same https origin, so every API call is
# same-origin — no CORS in play in production at all. Backend routes all live
# under /api (plus /health); everything else is the Next.js frontend.
{$SITE_ADDRESS}

# Compress everything that isn't already compressed (Caddy skips responses that arrive
# with a Content-Encoding, so the backend's own Brotli/gzip passes through untouched).
# This mainly covers the Next.js side — HTML, JS chunks, CSS — for slow connections
# and low-end devices; zstd/gzip are negotiated per-client via Accept-Encoding.
encode zstd gzip

# Baseline security headers — this is the one edge every production request actually
# crosses (the app itself sets none, relying on this layer, since it doesn't know at
# build time whether it's sitting behind Caddy, a different proxy, or bare).
header {
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "strict-origin-when-cross-origin"
	# Conservative first-pass policy: app code/assets stay same-origin, while the existing
	# weather, currency, image, and AI integrations remain reachable. Tighten after staging.
	Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://images.unsplash.com; connect-src 'self' https://open.er-api.com https://api.open-meteo.com https://api.openai.com https://api.groq.com https://generativelanguage.googleapis.com; worker-src 'self' blob:; media-src 'self' blob:; manifest-src 'self'"
	Permissions-Policy "camera=(self), microphone=(self), geolocation=(), accelerometer=(), gyroscope=(), magnetometer=()"
}

handle /api/* {
	reverse_proxy backend:8080
}

handle /health {
	reverse_proxy backend:8080
}

handle {
	reverse_proxy frontend:3000
}
